# Verktøykjeden for å bygge og kjøre control sin PX4 som SITL (på PC, uten Pixhawk).
# Koden ligger i submodulen px4/Flightcontroller-px4 og monteres inn, så imaget har bare verktøyene.
# Pakkene er de samme som PX4 sitt Tools/setup/ubuntu.sh --no-nuttx --no-sim-tools installerer.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    astyle build-essential ccache cmake cppcheck file g++ gcc gdb git lcov \
    libssl-dev libxml2-dev libxml2-utils make ninja-build \
    python3 python3-dev python3-pip python3-setuptools python3-wheel \
    rsync shellcheck unzip zip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python-pakkene fra control sin versjon av PX4, så de passer til koden submodulen peker på.
COPY px4/Flightcontroller-px4/Tools/setup/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Submodulen monteres her. Git klager ellers på at mappa eies av en annen bruker.
RUN git config --global --add safe.directory '*'
WORKDIR /px4
CMD ["bash"]
