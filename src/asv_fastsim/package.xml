<?xml version="1.0"?>
<package format="3">
  <name>asv_fastsim</name>
  <version>0.1.0</version>
  <description>Rask 2D-simulator av vår båt, uten grafikk, for mange tester. Bruker tallene fra asv_gazebo sin model.sdf.</description>
  <maintainer email="christufte@icloud.com">chris</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>asv_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
