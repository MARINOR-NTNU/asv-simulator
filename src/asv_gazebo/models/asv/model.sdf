<?xml version="1.0"?>
<!--
  Vår egen ASV. Skrogfilen skrog10-1.stl er delt i skrog, thrusterhus og propeller
  (meshes/), slik at thrusterne dreier og propellene snurrer synlig. Meshene brukes bare
  til visning. Fysikken er beskrevet med tall og enkle former under.

  Målt fra STL-filen: lengde 1,50 m, bredde 0,53 m, kjøl ved z = -0,25, dekk ved z = ca. 0,12.
  Origo er midt i lengden, x peker forover, y mot babord og z opp.

  ANSLAG som må erstattes med ekte tall: masse, tyngdepunkt, treghetsmoment, maks thrust,
  motstandskoeffisienter, og hvor langt og hvor fort thrusterne dreies. At akterthrusterne
  kan dreies, er bekreftet (2026-10-19).
-->
<sdf version="1.9">
  <model name="asv">

    <link name="base_link">
      <inertial>
        <!-- ANSLAG: 45 kg, midt i spennet 40-50 kg. Gir vannlinje ved z = -0,145 (dypgang 10,5 cm).
             40 kg gir z = -0,153 og 50 kg gir z = -0,136. Treghetsmomentet er regnet som en boks. -->
        <pose>-0.19 0 -0.12 0 0 0</pose>
        <mass>45.0</mass>
        <inertia>
          <ixx>1.24</ixx><iyy>7.65</iyy><izz>8.3</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>model://asv/meshes/hull.stl</uri>
            <!-- STL-filen er i millimeter -->
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Kollisjon er en enkel boks rundt skroget, ikke selve meshen. -->
      <collision name="hull_collision">
        <pose>0 0 -0.065 0 0 0</pose>
        <geometry>
          <box><size>1.5 0.5 0.37</size></box>
        </geometry>
      </collision>

      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/asv/sensors/imu</topic>
        <imu>
          <orientation_reference_frame>
            <localization>ENU</localization>
          </orientation_reference_frame>
        </imu>
      </sensor>

      <sensor name="navsat" type="navsat">
        <pose>0 0 0.15 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>/asv/sensors/gps</topic>
      </sensor>
    </link>

    <!--
      Angrepspunkt for motstanden i vannet (se SimpleHydrodynamics under). Det ligger 6 cm bak
      tyngdepunktet. ANSLAG: skrogets lateralplan har senter ved x = -0,05, men thrusterne og
      stagene akter virker som finner og trekker det bakover. Ligger punktet foran
      tyngdepunktet, blir båten retningsustabil og spinner rundt i høy fart.
    -->
    <link name="hydro_link">
      <pose>-0.25 0 -0.15 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="hydro_joint" type="fixed">
      <parent>base_link</parent>
      <child>hydro_link</child>
    </joint>

    <!-- Thrustere akter. Propellakselen ligger ved x = -0,696, y = +-0,199, z = -0,268 (fra STL-filen). -->
    <link name="left_pod_link">
      <pose>-0.696 0.199 -0.268 0 0 0</pose>
      <visual name="left_pod_visual">
        <geometry>
          <mesh>
            <uri>model://asv/meshes/left_pod.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <link name="left_prop_link">
      <pose>-0.696 0.199 -0.268 0 0 0</pose>
      <visual name="left_rotor_visual">
        <geometry>
          <mesh>
            <uri>model://asv/meshes/left_rotor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="left_pod_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_pod_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <!-- Videre enn de +-90 gradene vi tillater: et ledd som kjøres helt i stopp, låser seg. -->
        <limit><lower>-1.75</lower><upper>1.75</upper><effort>10</effort><velocity>10</velocity></limit>
      </axis>
    </joint>
    <joint name="left_prop_joint" type="revolute">
      <parent>left_pod_link</parent>
      <child>left_prop_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>100</effort><velocity>1000</velocity></limit>
        <dynamics><friction>0.01</friction><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <link name="right_pod_link">
      <pose>-0.696 -0.199 -0.268 0 0 0</pose>
      <visual name="right_pod_visual">
        <geometry>
          <mesh>
            <uri>model://asv/meshes/right_pod.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <link name="right_prop_link">
      <pose>-0.696 -0.199 -0.268 0 0 0</pose>
      <visual name="right_rotor_visual">
        <geometry>
          <mesh>
            <uri>model://asv/meshes/right_rotor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="right_pod_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_pod_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <!-- Videre enn de +-90 gradene vi tillater: et ledd som kjøres helt i stopp, låser seg. -->
        <limit><lower>-1.75</lower><upper>1.75</upper><effort>10</effort><velocity>10</velocity></limit>
      </axis>
    </joint>
    <joint name="right_prop_joint" type="revolute">
      <parent>right_pod_link</parent>
      <child>right_prop_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>100</effort><velocity>1000</velocity></limit>
        <dynamics><friction>0.01</friction><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- Baugthruster i tunnelen ved x = 0,54, z = -0,20. Positiv thrust skyver baugen mot babord. -->
    <link name="bow_prop_link">
      <pose>0.54 0 -0.20 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="bow_prop_joint" type="revolute">
      <parent>base_link</parent>
      <child>bow_prop_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>100</effort><velocity>1000</velocity></limit>
        <dynamics><friction>0.01</friction><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!--
      Oppdrift: en boks som har samme vannlinjeareal (ca. 0,58 m2) og oppdriftssenter
      (x = -0,19) som skroget. Bunnen av boksen er lagt slik at dypgangen stemmer med
      skroget for masser mellom 40 og 50 kg, så det holder å endre <mass> i det spennet.
      Utenfor det spennet må boksen regnes ut på nytt.
    -->
    <plugin name="vrx::PolyhedraBuoyancyDrag" filename="libPolyhedraBuoyancyDrag.so">
      <fluid_density>1000</fluid_density>
      <fluid_level>0.0</fluid_level>
      <!-- Motstanden her er lik i alle retninger, så den er slått av. All motstand ligger i
           SimpleHydrodynamics under, der hver retning har sine egne tall. -->
      <linear_drag>0.0</linear_drag>
      <angular_drag>0.0</angular_drag>
      <buoyancy name="hull_buoyancy">
        <link_name>base_link</link_name>
        <pose>-0.19 0 -0.051 0 0 0</pose>
        <geometry>
          <box><size>1.12 0.52 0.342</size></box>
        </geometry>
      </buoyancy>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>

    <!--
      Motstand i vannet. ANSLAG regnet ut fra skrogformen ved 45 kg (ikke målt på båten):
      - forover (xUU): friksjon på våt flate 0,82 m2 (ca. 2), nedsenket akterspeil 0,5 x 0,1 m
        (ca. 7,5), thrustere og stag (ca. 3,5), pluss litt for bølgemotstand.
      - sideveis (yVV): 0,5 * rho * Cd * lateralplan, med Cd = 1,1 og lateralplan 0,149 m2,
        pluss thrusterne.
      - dreiing (nRR): 0,5 * rho * Cd * integralet av |x|^3 * dypgang langs skroget (0,0137 m5),
        pluss thrusterne 0,70 m bak midten.
      - hiv, rull og stamp (zW, kP, mQ): valgt slik at båten demper svingninger på noen få
        perioder (dempingsforhold ca. 0,2-0,4).
      Kreftene angriper i hydro_link.
    -->
    <plugin name="vrx::SimpleHydrodynamics" filename="libSimpleHydrodynamics.so">
      <link_name>hydro_link</link_name>
      <xDotU>0.0</xDotU>
      <yDotV>0.0</yDotV>
      <nDotR>0.0</nDotR>
      <xU>2.0</xU>
      <xUU>14.0</xUU>
      <yV>5.0</yV>
      <yVV>90.0</yVV>
      <zW>400.0</zW>
      <kP>8.0</kP>
      <kPP>10.0</kPP>
      <mQ>50.0</mQ>
      <mQQ>30.0</mQQ>
      <nR>1.5</nR>
      <nRR>11.0</nRR>
    </plugin>

    <!-- Motorer. ANSLAG: 50 N per thruster og 25 N for baugthrusteren. -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>left_prop_joint</joint_name>
      <namespace>asv</namespace>
      <topic>thrusters/left/thrust</topic>
      <thrust_coefficient>0.1</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.09</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd>
      <min_thrust_cmd>-50</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>right_prop_joint</joint_name>
      <namespace>asv</namespace>
      <topic>thrusters/right/thrust</topic>
      <thrust_coefficient>0.1</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.09</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd>
      <min_thrust_cmd>-50</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>bow_prop_joint</joint_name>
      <namespace>asv</namespace>
      <topic>thrusters/bow/thrust</topic>
      <thrust_coefficient>0.1</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.06</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>25</max_thrust_cmd>
      <min_thrust_cmd>-25</min_thrust_cmd>
    </plugin>

    <!-- Dreiing av thrusterne (radianer). At de kan dreies, er bekreftet. ANSLAG: at de dreier 2 rad/s (cmd_max). -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_pod_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>2.0</cmd_max>
      <topic>/asv/thrusters/left/pos</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_pod_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>2.0</cmd_max>
      <topic>/asv/thrusters/right/pos</topic>
    </plugin>

    <!-- Publiserer leddvinklene, blant annet hvor thrusterne peker. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

  </model>
</sdf>
